foreach(component LAppView LAppLive2DManager LAppModel LAppPal)
  file(READ "${APP_SOURCE}/${component}.cpp" implementation)
  if (implementation MATCHES "LAppDelegate::GetInstance|#include \"LAppDelegate.hpp\"")
    message(FATAL_ERROR "${component} must not depend on the application singleton")
  endif ()
endforeach ()
file(READ "${APP_SOURCE}/LAppModel.cpp" model)
if (model MATCHES "LAppIPC::|#include \"LAppIPC.hpp\"")
  message(FATAL_ERROR "Model must consume per-frame input instead of IPC state")
endif ()
file(READ "${APP_SOURCE}/LAppLive2DManager.cpp" manager)
if (manager MATCHES "LAppView::|#include \"LAppView.hpp\"")
  message(FATAL_ERROR "Manager must not reverse-call View for drawing")
endif ()
file(READ "${APP_SOURCE}/LAppSpriteShader.cpp" sprite_shader)
if (NOT sprite_shader MATCHES "glDeleteProgram\\(_programId\\)")
  message(FATAL_ERROR "GL program must be deleted as a program before context teardown")
endif ()
