foreach(component LAppView LAppLive2DManager LAppModel LAppPal LAppSprite
    processor/model/ModelHotkeys processor/interaction/ModelInputDispatch
    processor/interaction/InteractionProcessor processor/interaction/ModelWindowState)
  if (component MATCHES "ModelInputDispatch$")
    set(required_extension .hpp)
  else ()
    set(required_extension .cpp)
  endif ()
  if (NOT EXISTS "${APP_SOURCE}/${component}${required_extension}")
    message(FATAL_ERROR "Required component ${component}${required_extension} is missing")
  endif ()
  foreach(extension .cpp .hpp)
    set(source "${APP_SOURCE}/${component}${extension}")
    if (EXISTS "${source}")
      file(READ "${source}" implementation)
      if (implementation MATCHES "LAppDelegate::GetInstance|#include \"LAppDelegate.hpp\"")
        message(FATAL_ERROR "${component}${extension} must not depend on the application singleton")
      endif ()
    endif ()
  endforeach ()
endforeach ()

foreach(extension .cpp .hpp)
  set(model_source "${APP_SOURCE}/LAppModel${extension}")
  if (EXISTS "${model_source}")
    file(READ "${model_source}" model)
    if (model MATCHES "LAppIPC::|#include \"LAppIPC.hpp\"")
      message(FATAL_ERROR "LAppModel${extension} must consume per-frame input instead of IPC state")
    endif ()
  endif ()

  set(manager_source "${APP_SOURCE}/LAppLive2DManager${extension}")
  if (EXISTS "${manager_source}")
    file(READ "${manager_source}" manager)
    if (manager MATCHES "LAppView::|#include \"LAppView.hpp\"")
      message(FATAL_ERROR "LAppLive2DManager${extension} must not reverse-call View for drawing")
    endif ()
  endif ()
endforeach ()
file(READ "${APP_SOURCE}/LAppSpriteShader.cpp" sprite_shader)
if (NOT sprite_shader MATCHES "glDeleteProgram\\(_programId\\)")
  message(FATAL_ERROR "GL program must be deleted as a program before context teardown")
endif ()
string(FIND "${sprite_shader}" "if (linked != GL_TRUE)" failed_link_check)
string(FIND "${sprite_shader}" "glUseProgram(programId)" use_program)
if (failed_link_check EQUAL -1 OR use_program EQUAL -1 OR use_program LESS failed_link_check)
  message(FATAL_ERROR "A program must be validated before glUseProgram is called")
endif ()
file(READ "${APP_SOURCE}/QtDesktopWindow.cpp" window)
if (window MATCHES "LAppDelegate::GetInstance|#include \"LAppDelegate.hpp\"")
  message(FATAL_ERROR "Window callbacks must use the explicit event sink")
endif ()
foreach(removed LAppWayland.cpp LAppWayland.hpp NativeDesktopWindow.cpp)
  if (EXISTS "${APP_SOURCE}/${removed}")
    message(FATAL_ERROR "Qt must be the only window backend; found ${removed}")
  endif ()
endforeach()
