foreach(extension .hpp .cpp)
  set(source "${APP_SOURCE}/AppCommandHandler${extension}")
  if (NOT EXISTS "${source}")
    message(FATAL_ERROR "Command handler source is missing: ${source}")
  endif ()
  file(READ "${source}" handler)
  if (handler MATCHES "IExternalControlPort|LAppIPC|_ipc|GetIPC|GetIpc")
    message(FATAL_ERROR "Command service must not retain or access the IPC transport")
  endif ()
endforeach()
