include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.5 COMPONENTS Core)
include("${CMAKE_CURRENT_LIST_DIR}/DeskWaifuPluginSDKTargets.cmake")
foreach(component IN LISTS DeskWaifuPluginSDK_FIND_COMPONENTS)
  if(component STREQUAL "Gui" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/DeskWaifuGuiPluginSDKTargets.cmake")
    find_dependency(Qt6 6.5 COMPONENTS Widgets)
    include("${CMAKE_CURRENT_LIST_DIR}/DeskWaifuGuiPluginSDKTargets.cmake")
    set(DeskWaifuPluginSDK_Gui_FOUND TRUE)
  else()
    set(DeskWaifuPluginSDK_${component}_FOUND FALSE)
    if(DeskWaifuPluginSDK_FIND_REQUIRED_${component})
      set(DeskWaifuPluginSDK_FOUND FALSE)
      set(DeskWaifuPluginSDK_NOT_FOUND_MESSAGE "Unavailable SDK component: ${component}")
    endif()
  endif()
endforeach()
