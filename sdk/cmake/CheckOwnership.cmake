if(NOT DEFINED SDK_ROOT)
  get_filename_component(SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
file(GLOB_RECURSE sdk_sources
  "${SDK_ROOT}/plugin/*.hpp" "${SDK_ROOT}/plugin/*.cpp"
  "${SDK_ROOT}/event/*.hpp" "${SDK_ROOT}/event/*.cpp"
  "${SDK_ROOT}/contracts/*.hpp" "${SDK_ROOT}/contracts/*.cpp"
  "${SDK_ROOT}/processor/*.hpp")
foreach(source IN LISTS sdk_sources)
  file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include")
  get_filename_component(source_directory "${source}" DIRECTORY)
  foreach(line IN LISTS includes)
    if(line MATCHES "[<\"](QLibrary|QPluginLoader|Cubism[^>\"]*)[>\"]")
      message(FATAL_ERROR "SDK cannot depend on plugin loaders or Cubism: ${source}: ${line}")
    endif()
    if(line MATCHES "[<\"]([^>\"]+)[>\"]")
      set(header "${CMAKE_MATCH_1}")
      if(header MATCHES "(^|/)\\.\\.(/|$)|^(platform|plugins|control|src)/" OR IS_ABSOLUTE "${header}")
        message(FATAL_ERROR "SDK cannot include private host/domain headers: ${source}: ${line}")
      endif()
    endif()
    if(line MATCHES "\"([^\"]+)\"")
      set(header "${CMAKE_MATCH_1}")
      if(NOT EXISTS "${SDK_ROOT}/${header}" AND NOT EXISTS "${source_directory}/${header}")
        message(FATAL_ERROR "SDK quoted include must resolve within the SDK: ${source}: ${line}")
      endif()
    endif()
  endforeach()
endforeach()
