cmake_minimum_required(VERSION 3.25)

# Preserve the historical aggregate gate while each adapter compiles only in
# its owner's test target. The dynamic test covers their real protocol chain.
foreach(program READING PERCEPTION IPC)
  if(program STREQUAL "PERCEPTION")
    execute_process(COMMAND "${${program}}" "${OCR_HELPER}" RESULT_VARIABLE result)
  else()
    execute_process(COMMAND "${${program}}" RESULT_VARIABLE result)
  endif()
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${program} pipeline coverage failed: ${result}")
  endif()
endforeach()
if(DEFINED ENV{DESKWAIFU_PIPELINE_SPEECH})
  execute_process(COMMAND "$ENV{DESKWAIFU_PIPELINE_SPEECH}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Speech failure adapter coverage failed: ${result}")
  endif()
endif()
execute_process(COMMAND "${DYNAMIC}" "${READING_PLUGIN}" "${PERCEPTION_PLUGIN}" "${OCR_HELPER}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Dynamic pipeline coverage failed: ${result}")
endif()
