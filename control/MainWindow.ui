       <layout class="QVBoxLayout" name="logLayout">
        <item>
         <widget class="QPlainTextEdit" name="responseLog">
          <property name="readOnly">
           <bool>true</bool>
          </property>
          <property name="placeholderText">
           <string>IPC responses appear here.</string>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QStatusBar" name="statusBar"/>
