#!/usr/bin/env sh

set -ue

GLEW_VERSION=2.3.1

SCRIPT_PATH=$(cd $(dirname $0) && pwd)

cd $SCRIPT_PATH/..

##############
# 配置 GLEW #
##############

# 下载并解压归档文件。
echo "- Setup GLEW $GLEW_VERSION"
echo Downloading...
curl -fsSL -o glew.zip \
  "https://github.com/nigels-com/glew/releases/download/glew-$GLEW_VERSION/glew-$GLEW_VERSION.zip"
echo 'Extracting...'
unzip -oq glew.zip
mv -f glew-* glew
rm glew.zip
