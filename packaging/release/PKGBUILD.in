# Maintainer: kals
# Generated from the selected release tag; no network acquisition during build.
pkgname=deskwaifu-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='DeskWaifu Rust application'
arch=('x86_64')
url='https://github.com/ad2248/DeskWaifu'
# No license grant is inferred from the retired C++ SDK dependencies.
license=('LicenseRef-Unknown')
depends=('glibc' 'gcc-libs' 'libpipewire' 'wl-clipboard')
makedepends=('cargo' 'clang' 'pkgconf')
optdepends=('pipewire: microphone capture daemon' 'wireplumber: default microphone selection')
provides=('deskwaifu')
conflicts=('deskwaifu')
options=('!debug' '!lto')
source=('deskwaifu.tar.gz')
sha256sums=('@SOURCE_SHA@')

build() {
  cd "$srcdir/deskwaifu"
  CARGO_NET_OFFLINE=true bash scripts/build.sh --release
}

package() {
  install -Dm755 "$srcdir/deskwaifu/target/release/deskwaifu" "$pkgdir/usr/lib/deskwaifu/deskwaifu"
  install -Dm755 "$srcdir/deskwaifu/target/release/deskwaifucli" "$pkgdir/usr/bin/deskwaifucli"
  local plugin
  for plugin in libdeskwaifu_test_plugin.so libdeskwaifu_voice_input.so; do
    install -Dm755 "$srcdir/deskwaifu/target/release/plugins/$plugin" "$pkgdir/usr/lib/deskwaifu/plugins/$plugin"
  done
  install -dm755 "$pkgdir/usr/bin"
  ln -s ../lib/deskwaifu/deskwaifu "$pkgdir/usr/bin/deskwaifu"
}
