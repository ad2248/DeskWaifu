# Maintainer: kals
# Generated from the selected release tag; no network acquisition during build.
pkgname=deskwaifu-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='DeskWaifu Rust application'
arch=('x86_64')
url='https://github.com/ad2248/DeskWaifu'
# The workspace does not declare a license.
license=('LicenseRef-Unknown')
depends=(@DEPENDS@)
makedepends=(@MAKEDEPENDS@)
optdepends=(@OPTDEPENDS@)
provides=('deskwaifu')
conflicts=('deskwaifu')
options=('!debug' '!lto')
source=('deskwaifu.tar.gz')
sha256sums=('@SOURCE_SHA@')

build() {
  cd "$srcdir/deskwaifu" || return
  CARGO_NET_OFFLINE=true cargo build --workspace --locked --release --target-dir "$srcdir/deskwaifu/target"
}

package() {
  local output="$srcdir/deskwaifu/target/release"
  install -Dm755 "$output/deskwaifu" "$pkgdir/usr/lib/deskwaifu/deskwaifu" || return
  local binary plugin
  for binary in @BINARIES@; do
    install -Dm755 "$output/$binary" "$pkgdir/usr/bin/$binary" || return
  done
  for plugin in @PLUGINS@; do
    install -Dm755 "$output/$plugin" "$pkgdir/usr/lib/deskwaifu/plugins/$plugin" || return
  done
  ln -s ../lib/deskwaifu/deskwaifu "$pkgdir/usr/bin/deskwaifu"
}
