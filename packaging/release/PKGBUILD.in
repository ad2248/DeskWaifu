# Maintainer: kals
# Generated from the selected release tag; no network acquisition during build.
pkgname=deskwaifu-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='DeskWaifu Rust application'
arch=('x86_64')
url='https://github.com/ad2248/DeskWaifu'
# No license grant is inferred from the retired C++ SDK dependencies.
license=('LicenseRef-Unknown')
depends=('glibc' 'gcc-libs')
makedepends=('cargo')
provides=('deskwaifu')
conflicts=('deskwaifu')
options=('!debug' '!lto')
source=('deskwaifu.tar.gz')
sha256sums=('@SOURCE_SHA@')

build() {
  cd "$srcdir/deskwaifu"
  cargo build --release --frozen
}

package() {
  install -Dm755 "$srcdir/deskwaifu/target/release/deskwaifu" "$pkgdir/usr/bin/deskwaifu"
}
