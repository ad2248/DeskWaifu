find_package(Python3 REQUIRED COMPONENTS Interpreter)

function(deskwaifu_owner path result)
  file(REAL_PATH "${path}" absolute)
  file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${absolute}")
  if(relative MATCHES "^\\.\\.(/|$)" OR relative MATCHES "^(build[^/]*|thirdParty|CubismSdkForNative[^/]*)(/|$)")
    set(owner external)
  elseif(relative MATCHES "^sdk(/|$)")
    set(owner sdk)
  elseif(relative MATCHES "^platform(/|$)")
    set(owner platform)
  elseif(relative MATCHES "^src/plugins/([^/]+)(/|$)")
    set(owner "plugin:${CMAKE_MATCH_1}")
  elseif(relative STREQUAL "" OR relative STREQUAL "install.sh" OR relative MATCHES "^(cmake|scripts|tests|packaging|\\.gitea)(/|$)")
    set(owner platform)
  elseif(relative MATCHES "^research/ocr(/|$)")
    set(owner "plugin:perception")
  elseif(relative STREQUAL "deskwaifu-ctl")
    set(owner "plugin:ipc")
  else()
    set(owner unassigned)
  endif()
  set(${result} "${owner}" PARENT_SCOPE)
endfunction()

function(deskwaifu_check_links target owner visited)
  if(target IN_LIST visited)
    return()
  endif()
  list(APPEND visited "${target}")
  foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(links ${target} ${property})
    if(NOT links)
      continue()
    endif()
    foreach(link IN LISTS links)
      if(IS_ABSOLUTE "${link}")
        file(RELATIVE_PATH artifact "${PROJECT_BINARY_DIR}" "${link}")
        if(artifact MATCHES "^(src/)?plugins/([^/]+)(/|$)")
          set(link_owner "plugin:${CMAKE_MATCH_2}")
        else()
          deskwaifu_owner("${link}" link_owner)
        endif()
        if(NOT link_owner STREQUAL external AND NOT link_owner STREQUAL owner AND NOT link_owner STREQUAL sdk)
          message(FATAL_ERROR "${target} (${owner}) cannot link ${link} (${link_owner})")
        endif()
      endif()
    endforeach()
    # Inspect conditional and interface dependencies as well as direct links.
    string(REGEX REPLACE "\\$<[^:<>]+:" ";" links "${links}")
    string(REGEX MATCHALL "[A-Za-z0-9_][A-Za-z0-9_:+.-]*" candidates "${links}")
    foreach(link IN LISTS candidates)
      if(NOT TARGET "${link}")
        continue()
      endif()
      get_target_property(link_directory ${link} SOURCE_DIR)
      if(link_directory)
        deskwaifu_owner("${link_directory}" link_owner)
        if(NOT link_owner STREQUAL external AND NOT link_owner STREQUAL owner AND NOT link_owner STREQUAL sdk)
          message(FATAL_ERROR "${target} (${owner}) cannot link ${link} (${link_owner})")
        endif()
      endif()
      deskwaifu_check_links("${link}" "${owner}" "${visited}")
    endforeach()
  endforeach()
endfunction()

function(deskwaifu_validate_directory directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type ${target} TYPE)
    if(type STREQUAL UTILITY)
      continue()
    endif()
    get_target_property(source_directory ${target} SOURCE_DIR)
    deskwaifu_owner("${source_directory}" owner)
    get_target_property(binary_directory ${target} BINARY_DIR)
    if(type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|EXECUTABLE)$")
      set_property(GLOBAL APPEND_STRING PROPERTY DESKWAIFU_ARTIFACTS
        "file\t${owner}\t$<TARGET_FILE:${target}>\n")
    endif()
    if(NOT type STREQUAL INTERFACE_LIBRARY)
      set_property(GLOBAL APPEND_STRING PROPERTY DESKWAIFU_ARTIFACTS
        "directory\t${owner}\t${binary_directory}/CMakeFiles/${target}.dir\n")
    endif()
    if(type STREQUAL OBJECT_LIBRARY)
      set_property(GLOBAL APPEND_STRING PROPERTY DESKWAIFU_ARTIFACTS
        "file\t${owner}\t$<JOIN:$<TARGET_OBJECTS:${target}>,\nfile\t${owner}\t>\n")
    endif()
    if(owner STREQUAL external)
      continue()
    endif()
    if(owner STREQUAL unassigned)
      message(FATAL_ERROR "Target ${target} has no SDK/platform/plugin owner: ${source_directory}")
    endif()
    deskwaifu_check_links("${target}" "${owner}" "")
    foreach(property INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
      get_target_property(includes ${target} ${property})
      foreach(include IN LISTS includes)
        string(REGEX REPLACE "^\\$<BUILD_INTERFACE:(.*)>$" "\\1" include "${include}")
        if(NOT IS_ABSOLUTE "${include}")
          continue()
        endif()
        deskwaifu_owner("${include}" include_owner)
        if(NOT include_owner STREQUAL external AND NOT include_owner STREQUAL owner AND NOT include_owner STREQUAL sdk)
          message(FATAL_ERROR "${target} (${owner}) cannot include directory ${include} (${include_owner})")
        endif()
      endforeach()
    endforeach()
    if(type STREQUAL INTERFACE_LIBRARY)
      continue()
    endif()
    if(owner MATCHES "^plugin:" AND NOT type STREQUAL EXECUTABLE)
      set_target_properties(${target} PROPERTIES
        C_VISIBILITY_PRESET hidden CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
    endif()
    get_target_property(sources ${target} SOURCES)
    foreach(source IN LISTS sources)
      if(source MATCHES "^\\$<" OR source MATCHES "${PROJECT_BINARY_DIR}")
        continue()
      endif()
      if(NOT IS_ABSOLUTE "${source}")
        set(source "${source_directory}/${source}")
      endif()
      deskwaifu_owner("${source}" source_owner)
      if(NOT source_owner STREQUAL owner AND NOT source_owner STREQUAL external)
        message(FATAL_ERROR "${target} (${owner}) cannot compile ${source} (${source_owner})")
      endif()
    endforeach()
    foreach(language C CXX)
      get_target_property(launcher ${target} ${language}_COMPILER_LAUNCHER)
      set(checked_launcher "${Python3_EXECUTABLE};${PROJECT_SOURCE_DIR}/platform/tooling/check_dependencies.py;${PROJECT_SOURCE_DIR};${owner}")
      if(launcher)
        list(APPEND checked_launcher ${launcher})
      endif()
      set_property(TARGET ${target} PROPERTY ${language}_COMPILER_LAUNCHER "${checked_launcher}")
      get_target_property(launcher ${target} ${language}_LINKER_LAUNCHER)
      set(checked_launcher "${Python3_EXECUTABLE};${PROJECT_SOURCE_DIR}/platform/tooling/check_link_dependencies.py;${PROJECT_BINARY_DIR};${owner}")
      if(launcher)
        list(APPEND checked_launcher ${launcher})
      endif()
      set_property(TARGET ${target} PROPERTY ${language}_LINKER_LAUNCHER "${checked_launcher}")
    endforeach()
    if(type STREQUAL STATIC_LIBRARY)
      # Compiler-driver linker launchers do not run for ar/ranlib. Check those
      # inputs too, including evaluated TARGET_OBJECTS sources and response files.
      set(archive_launcher "")
      foreach(argument IN ITEMS "${Python3_EXECUTABLE}"
          "${PROJECT_SOURCE_DIR}/platform/tooling/check_link_dependencies.py"
          "${PROJECT_BINARY_DIR}" "${owner}")
        string(REPLACE "'" "'\\''" argument "${argument}")
        string(APPEND archive_launcher "'${argument}' ")
      endforeach()
      get_target_property(launcher ${target} RULE_LAUNCH_LINK)
      if(launcher)
        string(APPEND archive_launcher "${launcher}")
      endif()
      set_property(TARGET ${target} PROPERTY RULE_LAUNCH_LINK "${archive_launcher}")
    endif()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    deskwaifu_validate_directory("${child}")
  endforeach()
endfunction()

function(deskwaifu_validate_boundaries)
  set_property(GLOBAL PROPERTY DESKWAIFU_ARTIFACTS "")
  deskwaifu_validate_directory("${PROJECT_SOURCE_DIR}")
  get_property(artifacts GLOBAL PROPERTY DESKWAIFU_ARTIFACTS)
  # Actual target outputs, not directory naming conventions, determine ownership.
  # Separate configuration files also work with pre-3.27 linker launchers.
  file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/deskwaifu-artifacts-$<CONFIG>.txt" CONTENT "${artifacts}")
endfunction()
