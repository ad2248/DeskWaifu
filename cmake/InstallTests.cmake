# Keep installed tests independent of the source/build tree. Source inspection,
# configure/compile and mutation gates remain in the ordinary source CI job.
if(NOT DESKWAIFU_TEST_TOOLS)
  set(DESKWAIFU_TEST_TOOLS "${CMAKE_SOURCE_DIR}/scripts")
endif()
set(_test_root "${CMAKE_INSTALL_FULL_LIBDIR}/deskwaifu/tests")
set(_component DeskWaifuTests)
if(PROJECT_NAME STREQUAL "deskwaifu_ocr")
  set(_test_root "${CMAKE_INSTALL_FULL_LIBDIR}/deskwaifu/ocr-tests")
  set(_component DeskWaifuOCRTests)
endif()

function(_deskwaifu_targets directory output)
  get_property(result DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    _deskwaifu_targets("${child}" nested)
    list(APPEND result ${nested})
  endforeach()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

_deskwaifu_targets("${CMAKE_SOURCE_DIR}" _targets)
set(_mapping "[\n")
foreach(target IN LISTS _targets)
  get_target_property(source ${target} SOURCE_DIR)
  if(source MATCHES "/(tests|testing)(/|$)" OR target MATCHES "(-test|_test|-fixture)$" OR target STREQUAL "ocr-module-probe")
    set(_test_target_${target} TRUE)
  endif()
  get_target_property(type ${target} TYPE)
  if(NOT type MATCHES "^(EXECUTABLE|MODULE_LIBRARY|SHARED_LIBRARY)$")
    continue()
  endif()
  set(destination "")
  if(_test_target_${target})
    set(destination "${_test_root}/targets/${target}")
    install(TARGETS ${target} RUNTIME DESTINATION "${destination}" COMPONENT ${_component}
      LIBRARY DESTINATION "${destination}" COMPONENT ${_component})
    if(type STREQUAL "EXECUTABLE" AND TARGET deskwaifu-cursor-guard)
      install(CODE "file(CREATE_LINK \"${CMAKE_INSTALL_FULL_BINDIR}/deskwaifu-cursor-guard\" \"\$ENV{DESTDIR}${destination}/deskwaifu-cursor-guard\" SYMBOLIC)" COMPONENT ${_component})
    endif()
  elseif(target STREQUAL "deskwaifu-ocr")
    set(destination "${CMAKE_INSTALL_FULL_LIBDIR}/deskwaifu/ocr")
  elseif(type STREQUAL "EXECUTABLE")
    set(destination "${CMAKE_INSTALL_FULL_BINDIR}")
  elseif(target MATCHES "^(.+)_plugin$" OR target MATCHES "^(.+)_gui_plugin$")
    string(REGEX REPLACE "(_gui)?_plugin$" "" owner "${target}")
    set(destination "${CMAKE_INSTALL_FULL_LIBDIR}/deskwaifu/plugins/${owner}")
  else()
    set(destination "${CMAKE_INSTALL_FULL_LIBDIR}")
  endif()
  set(_installed_${target} "${destination}/$<TARGET_FILE_NAME:${target}>")
  string(APPEND _mapping "{\"build\":\"$<TARGET_FILE:${target}>\",\"installed\":\"${_installed_${target}}\"},\n")
endforeach()
string(APPEND _mapping "null]\n")
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/test-targets.json" CONTENT "${_mapping}")

# Only test targets' embedded fixture locations change. Production targets keep
# exactly the same flags whether tests are installed or executed by CI or not.
foreach(target IN LISTS _targets)
  if(NOT _test_target_${target})
    continue()
  endif()
  get_target_property(definitions ${target} COMPILE_DEFINITIONS)
  if(NOT definitions)
    continue()
  endif()
  foreach(other IN LISTS _targets)
    if(DEFINED _installed_${other})
      string(REPLACE "$<TARGET_FILE:${other}>" "${_installed_${other}}" definitions "${definitions}")
    endif()
  endforeach()
  string(REPLACE "${CMAKE_BINARY_DIR}/plugins" "${CMAKE_INSTALL_FULL_LIBDIR}/deskwaifu/plugins" definitions "${definitions}")
  if(SDK_ROOT_PATH)
    string(REPLACE "${SDK_ROOT_PATH}/Samples/Resources" "${_test_root}/resources" definitions "${definitions}")
  endif()
  set_property(TARGET ${target} PROPERTY COMPILE_DEFINITIONS "${definitions}")
endforeach()

install(FILES "${CMAKE_BINARY_DIR}/installed-tests.json" DESTINATION "${_test_root}" COMPONENT ${_component})
install(PROGRAMS "${DESKWAIFU_TEST_TOOLS}/run-installed-tests.py" DESTINATION "${_test_root}" RENAME run.py COMPONENT ${_component})
if(SDK_ROOT_PATH)
  install(DIRECTORY "${SDK_ROOT_PATH}/Samples/Resources/" DESTINATION "${_test_root}/resources" COMPONENT ${_component})
endif()
